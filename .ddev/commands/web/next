#!/bin/bash

## Description: [ExtDev] Tag new extension version.
## Usage: next
## Example: "ddev next, ddev next patch, ddev next minor, ddev next major"

set -e

DEFAULT_BRANCH=$(git remote show origin | grep 'HEAD branch' | cut -d' ' -f5)

# Ensure DEFAULT_BRANCH is set
if [ -z "$DEFAULT_BRANCH" ]; then
    echo "Error: DEFAULT_BRANCH could not be determined."
    exit 1
fi

# Check if on '${DEFAULT_BRANCH}' branch
CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
if [ "$CURRENT_BRANCH" != "$DEFAULT_BRANCH" ]; then
    echo "You are on branch '$CURRENT_BRANCH'. Before tagging please switch to the '$DEFAULT_BRANCH' branch and make sure it's up to date by running 'git pull'. Then run 'ddev next' command again."
    exit 1
fi

# Fetch the latest state of the remote branch
if ! git fetch -q origin $DEFAULT_BRANCH; then
    echo "Error: Failed to fetch from origin. Please check your network connection and remote repository configuration."
    exit 1
fi

# Check if the local branch is behind the remote branch
LOCAL=$(git rev-parse @)
REMOTE=$(git rev-parse @{u})
BASE=$(git merge-base @ @{u})

if [ "$LOCAL" != "$REMOTE" ]; then
    if [ "$LOCAL" == "$BASE" ]; then
        echo "Your local '$DEFAULT_BRANCH' branch is behind the remote. Please update it with 'git pull' and run 'ddev next' command again."
        exit 1
    elif [ "$REMOTE" == "$BASE" ]; then
        echo "Your local '$DEFAULT_BRANCH' branch has commits that are not pushed to the remote. Please push your changes with 'git push' and run 'ddev next' command again."
        exit 1
    else
        echo "Your local '$DEFAULT_BRANCH' branch has diverged from the remote. Please resolve the divergence before proceeding."
        exit 1
    fi
fi


versionType=${1:-patch}
if [ ! -z "$versionType" ]; then
    if [ "$versionType" != "patch" ] && [ "$versionType" != "minor" ] && [ "$versionType" != "major" ]; then
        echo "Error: Invalid argument. Please use 'patch', 'minor', or 'major'."
        exit 1
    fi
fi

# Validate and increment version
lastTag=$(git tag -l --sort=v:refname | tail -1)
if ! [[ $lastTag =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    echo "Error: Last tag '$lastTag' does not follow semantic versioning."
    exit 1
fi

IFS='.' read -ra lastTagParts <<< "$lastTag"
major=${lastTagParts[0]}
minor=${lastTagParts[1]}
patch=${lastTagParts[2]}

# Not `((x++))` - it returns status 1 when x is 0, which stops the script because of `set -e`
case $versionType in
    major)
        major=$((major + 1))
        minor=0
        patch=0
        ;;
    minor)
        minor=$((minor + 1))
        patch=0
        ;;
    patch)
        patch=$((patch + 1))
        ;;
esac

NEXT_TAG="$major.$minor.$patch"

if git rev-parse "$NEXT_TAG" >/dev/null 2>&1; then
    echo "Error: Tag '$NEXT_TAG' already exists. Please check the current version."
    exit 1
fi

# Version files are updated through a pull request (default branch can be protected), so the script runs twice:
# 1st run updates version files and prints commands to open a pull request with them,
# 2nd run (after the pull request is merged) finds the files up to date and prints commands to push the tag only.
# The version is computed from the last tag, so the 2nd run computes the same version as the 1st one.
CURRENT_VERSION=$(sed -n "s/.*'version' => '\([0-9]\+\.[0-9]\+\.[0-9]\+\)'.*/\1/p" ./ext_emconf.php | head -1)
if [ "$CURRENT_VERSION" != "$lastTag" ] && [ "$CURRENT_VERSION" != "$NEXT_TAG" ]; then
    echo "Error: ext_emconf.php has version '$CURRENT_VERSION', which is neither the last tag '$lastTag' nor the next version '$NEXT_TAG'."
    echo "Run 'ddev next' with the version type ('patch', 'minor' or 'major') which gives '$CURRENT_VERSION'."
    exit 1
fi

# Update files with the new version
sed -i "s/'version' => '[0-9]\+\.[0-9]\+\.[0-9]\+'/'version' => '$NEXT_TAG'/g" ./ext_emconf.php
sed -i -E "s/(\"version\": \")[0-9]+\.[0-9]+\.[0-9]+(\")/\1$NEXT_TAG\2/" ./composer.json
sed -i "s/release=\"[0-9]\+\.[0-9]\+\.[0-9]\+\"/release=\"$NEXT_TAG\"/g" ./Documentation/guides.xml
# `version` of the documentation is "major.minor", the <project> element spans several lines
sed -i -E "/<project/,/>/ s/(\s)version=\"[^\"]*\"/\1version=\"$major.$minor\"/" ./Documentation/guides.xml

VERSION_FILES="Documentation/guides.xml ext_emconf.php composer.json"

if ! git diff --quiet -- $VERSION_FILES; then
    echo "Version files are updated to '$NEXT_TAG'. Copy the command below and run it to push them to a new branch:"
    echo "zsh -e -c \"git switch -c 'version-$NEXT_TAG'; git add $VERSION_FILES; git commit -m 'Tag version $NEXT_TAG'; git push -u origin 'version-$NEXT_TAG'\""
    echo "Then open a pull request to '$DEFAULT_BRANCH', merge it, switch to '$DEFAULT_BRANCH', run 'git pull' and run 'ddev next $versionType' again to tag the version."
    exit 0
fi

# Prepare command to tag the new version
echo "Version files are up to date. Copy the command below and run it to tag the new version:"
echo "zsh -e -c \"git tag -a '$NEXT_TAG' -m 'Version $NEXT_TAG' -s; git push origin '$NEXT_TAG'\""
